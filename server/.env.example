# Database (SQLite file)
DATABASE_URL="file:./dev.db"

# Auth — change this in production
JWT_SECRET="dev-secret-change-me"

# Server
PORT=4000

# LLM (OpenAI-compatible). Leave LLM_API_KEY empty to degrade to manual entry.
