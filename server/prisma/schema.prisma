// Prisma schema — see DESIGN.md section 3 for the full data model rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  students    Student[]     @relation("OwnedStudents")
  classes     Class[]       @relation("TaughtClasses")
  attendances Attendance[]  @relation("RecordedAttendances")
  followUps   FollowUp[]    @relation("RecordedFollowUps")

  @@map("users")
}

enum StudentStatus {
  LEAD // 咨询意向
  TRIAL_SCHEDULED // 已约试听
  TRIAL_DONE // 试听完待跟进
  ENROLLED // 已报名
  CHURNED // 流失
}

model Student {
  id            String        @id @default(cuid())
  adminId       String
  admin         User          @relation("OwnedStudents", fields: [adminId], references: [id])
  name          String
  nickname      String?
  guardianName  String?
  guardianPhone String?
  phone         String?
  level         String?
  status        StudentStatus @default(LEAD)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  enrollments       Enrollment[]
  memberships       ClassEnrollment[]
  attendances       Attendance[]
  feedbacks         LessonFeedback[]
  followUps         FollowUp[]
  creditTransactions CreditTransaction[]

  @@index([adminId])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  EXHAUSTED
  REFUNDED
}

// 「课时账户」— one record per purchase. creditsRemaining is the source of truth.
model Enrollment {
  id               String           @id @default(cuid())
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id])
  creditsTotal     Int
  creditsRemaining Int
  note             String?
  status           EnrollmentStatus @default(ACTIVE)
  purchasedAt      DateTime         @default(now())

  creditTransactions CreditTransaction[]

  @@index([studentId])
  @@map("enrollments")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// 「班级」是每周固定模板（dayOfWeek + startTime + endTime）。
model Class {
  id        String      @id @default(cuid())
  name      String
  subject   String?
  level     String?
  teacherId String
  teacher   User        @relation("TaughtClasses", fields: [teacherId], references: [id])
  dayOfWeek Int // 1=Mon .. 7=Sun (ISO-8601)
  startTime String // "HH:MM" Melbourne local
  endTime   String // "HH:MM" Melbourne local
  capacity  Int         @default(10)
  status    ClassStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  lessons Lesson[]
  members ClassEnrollment[]

  @@index([teacherId])
  @@map("classes")
}

enum MembershipStatus {
  ACTIVE
  WITHDRAWN
}

model ClassEnrollment {
  id         String           @id @default(cuid())
  classId    String
  class      Class            @relation(fields: [classId], references: [id])
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  status     MembershipStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_enrollments")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// 「课」是班级在某一天的具体实例。
model Lesson {
  id      String       @id @default(cuid())
  classId String
  class   Class        @relation(fields: [classId], references: [id])
  date    String // "YYYY-MM-DD" Melbourne local date
  status  LessonStatus @default(SCHEDULED)

  attendances        Attendance[]
  feedbacks          LessonFeedback[]
  creditTransactions CreditTransaction[]

  @@unique([classId, date])
  @@index([date])
  @@map("lessons")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// 出勤即扣课时凭证。creditsDeducted 记录本堂课扣了几个课时。
model Attendance {
  id              String           @id @default(cuid())
  lessonId        String
  lesson          Lesson           @relation(fields: [lessonId], references: [id])
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  status          AttendanceStatus
  creditsDeducted Int              @default(0)
  recordedById    String
  recordedBy      User             @relation("RecordedAttendances", fields: [recordedById], references: [id])
  recordedAt      DateTime         @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("attendances")
}

enum FeedbackSource {
  LLM
  MANUAL
}

model LessonFeedback {
  id          String         @id @default(cuid())
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id])
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id])
  summary     String
  strengths   String?
  nextSteps   String?
  generatedBy FeedbackSource @default(MANUAL)
  createdAt   DateTime       @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("lesson_feedbacks")
}

enum FollowUpType {
  CALL // 电话
  WECHAT // 微信
  MEETING // 面谈
  TRIAL // 试听
  OTHER
}

// 「跟进记录」——顾问对学生的每次跟进动作（切片②：学生跟进/待办）。
// 记录方式 + 结果摘要 + 可选的「下次跟进日期」，到期回到「今日待跟进」。
model FollowUp {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  adminId        String
  admin          User         @relation("RecordedFollowUps", fields: [adminId], references: [id])
  type           FollowUpType
  content        String
  nextFollowUpAt DateTime?
  completed      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([studentId])
  @@index([adminId])
  @@index([nextFollowUpAt])
  @@map("follow_ups")
}

enum CreditTxType {
  PURCHASE // 报名/续费 +N
  DEDUCT // 出勤扣课时 -1
  REFUND // 退费（预留）
}

// 「课时流水」——课时账户的每一笔变动（切片③：课时流水账）。
// amount：+N 购买 / -1 扣课；balanceAfter 记该笔之后所属 Enrollment 的剩余余额。
model CreditTransaction {
  id           String         @id @default(cuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?    @relation(fields: [enrollmentId], references: [id])
  lessonId     String?
  lesson       Lesson?        @relation(fields: [lessonId], references: [id])
  type         CreditTxType
  amount       Int
  balanceAfter Int
  note         String?
  createdAt    DateTime       @default(now())

  @@index([studentId])
  @@index([enrollmentId])
  @@map("credit_transactions")
}
