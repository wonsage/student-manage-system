# Database (Postgres). 本地开发：docker compose up -d db（见根目录 docker-compose.yml）
# 部署到 Vercel：换成 Neon 连接串（见 DEPLOY.md）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/student_manage"

# Auth — change this in production
JWT_SECRET="dev-secret-change-me"

# Server
PORT=4000

# LLM (OpenAI-compatible). Leave LLM_API_KEY empty to degrade to manual entry.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
